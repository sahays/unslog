{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT c.id, c.name, c.role, c.canonical_role,\n                   c.owner_id, c.updated_at,\n                   u.label AS owner_label\n            FROM companies c\n            JOIN users u ON u.id = c.owner_id\n            WHERE c.is_public = TRUE\n            ORDER BY c.updated_at DESC\n            ",
