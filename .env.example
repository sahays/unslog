PORT=3000
HOST=127.0.0.1
# Postgres is the live store. Defaults to the project-scoped `unslog-pg`
# container started by `scripts/dev-up.sh`.
DATABASE_URL=postgres://unslog:unslog@localhost:5432/unslog
# sqlx-cli prepare offline mode — keeps `cargo check` working without a live DB.
SQLX_OFFLINE=true
OPENROUTER_API_KEY=
# Optional attribution URL sent to OpenRouter as HTTP-Referer.
# Leave blank to omit the header (recommended for local/personal installs).
UNSLOG_REFERER=
RUST_LOG=info,unslog=debug
# Master invite code — required. 12-char alphanumeric; CSPRNG-generated.
# Generate with: python3 -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(12)))"
MASTER_INVITE_CODE=
MASTER_USER_LABEL=master

# Multi-user (Phase 1+)
# Session signing key auto-generated at data/session.key on first boot. Don't edit.
SESSION_COOKIE_NAME=__Host-session
CSRF_COOKIE_NAME=__Host-csrf
# Brute-force protection on /login: max attempts per IP per window (seconds).
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECS=300
# Tier caps — daily request budgets. Master is exempt.
PRO_REQUEST_CAP_DAILY=500
PRO_MAX_REQUEST_CAP_DAILY=2000
# In dev only: drop Secure flag on cookies so http://localhost works without TLS.
DEV_INSECURE=true

# ── Legacy Mongo (one-shot import only) ─────────────────────────────────
# Only needed if you intend to run the one-shot `import_from_mongo`
# binary to copy your old MongoDB-backed data into Postgres. The live
# app no longer reads these.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=behavioral_coach
